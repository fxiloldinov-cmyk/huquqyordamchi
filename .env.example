# Netlify -> Site configuration -> Environment variables bo'limida sozlang (Scopes: Functions).
# Bu qiymatlarni ommaviy GitHub repozitoriyga yoki ZIP arxivga yozmang. O'zgartirgandan keyin qayta deploy qiling.

# ---- AI (majburiy, AI funksiyalari uchun) ----
GEMINI_API_KEY=
# Ixtiyoriy: model(lar) vergul bilan. Bo'sh — gemini-3.8-flash → gemini-flash-latest → gemini-3.6-flash → gemini-2.5-flash
GEMINI_MODEL=
# Ixtiyoriy: low (standart) | medium | high | off
GEMINI_THINKING_LEVEL=low

# ---- AI sarfi va limitlar (ixtiyoriy; standart qiymatlar qavsda) ----
# 1 — barcha AI so'rovlarini darhol o'chirish (favqulodda)
HK_AI_DISABLED=
# Butun sayt bo'yicha kunlik AI so'rovlari (600). Kazus davomi ham alohida so'rov hisoblanadi.
HK_AI_DAILY_LIMIT=
# Bitta IP uchun soatlik AI so'rovlari (40)
HK_AI_IP_HOURLY=
# Bitta hisob uchun kunlik AI so'rovlari (150)
HK_AI_USER_DAILY=

# ---- Email (ixtiyoriy; emailni tasdiqlash va parolni tiklash uchun) ----
# Resend.com kaliti va tasdiqlangan domendagi jo'natuvchi. Bo'sh bo'lsa, sayt "xat yuborilmadi — sozlanmagan" deydi.
RESEND_API_KEY=
HK_MAIL_FROM=

# ---- Boshqa ----
# Ruxsat etilgan domenlar (vergul bilan). Bo'sh — faqat saytning o'z domeni.
ALLOWED_ORIGINS=

# ---- Faqat baholash skripti uchun (lokal; Netlify'ga kerak emas) ----
# 1 mln token narxi, USD — `npm run eval:live` xarajatni hisoblashi uchun
HK_PRICE_IN_PER_M=
HK_PRICE_OUT_PER_M=
HK_EVAL_LIMIT=
